{
  "name": "Flow",
  "short_name": "Flow",
  "description": "Gestor de tareas para equipo interno",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FBFBFA",
  "theme_color": "#40e0d0",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nueva tarea",
      "short_name": "Nueva tarea",
      "url": "/mis-tareas?tab=personal&new=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mis tareas",
      "short_name": "Mis tareas",
      "url": "/mis-tareas",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Bandeja",
      "short_name": "Bandeja",
      "url": "/bandeja",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "photos", "accept": ["image/*"] }]
    }
  }
}
